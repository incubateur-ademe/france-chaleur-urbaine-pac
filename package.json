{
  "name": "france-chaleur-urbaine-ifpen",
  "version": "0.1.0",
  "private": false,
  "engines": {
    "node": "24",
    "pnpm": "10"
  },
  "type": "module",
  "description": "Comparateur IFPEN basé sur Vite, React, React DSFR et les règles publicodes France Chaleur Urbaine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/incubateur-ademe/france-chaleur-urbaine-ifpen.git"
  },
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/incubateur-ademe/france-chaleur-urbaine-ifpen/issues"
  },
  "homepage": "https://github.com/incubateur-ademe/france-chaleur-urbaine-ifpen#readme",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm ts && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "husky",
    "lint": "biome check --max-diagnostics 50 .",
    "lint:fix": "biome check --max-diagnostics 50 --write .",
    "lint:fix:file": "biome check --write",
    "lint:ci": "biome ci --diagnostic-level error .",
    "test": "vitest run",
    "test:watch": "vitest dev",
    "test:coverage": "vitest run --coverage",
    "ts": "pnpm tsc --build --clean && pnpm tsc --noEmit"
  },
  "dependencies": {
    "@betagouv/france-chaleur-urbaine-publicodes": "1.8.0",
    "@codegouvfr/react-dsfr": "^1.32.0",
    "publicodes": "1.10.1",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.3",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "node-talisman": "^1.29.22",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.4"
  },
  "resolutions": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "pnpm": {
    "overrides": {
      "preact@>=10.28.0 <10.28.2": ">=10.28.2",
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "webpack@>=5.49.0 <=5.104.0": ">=5.104.1",
      "minimatch@>=5.0.0 <5.1.8": ">=5.1.8",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "picomatch@<2.3.2": ">=2.3.2"
    }
  }
}
